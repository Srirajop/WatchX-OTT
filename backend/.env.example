# SubtitleAI V2 — Environment Variables
# Copy this to .env and fill in your values

# Groq API Key — FREE at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Translation provider keys (OPTIONAL server-side fallback) ───────────────
# Subtitlers normally paste their own key in the Auto-Translate UI. These
# env vars are only used when a key is left blank in the UI. Leave empty to
# require each user to paste their own key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPL_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
AZURE_TRANSLATOR_KEY=
# LibreTranslate / Ollama / Google (free) need no key.
# The free Google Translate web endpoint needs no key at all.

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=subtitleai_v2
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Frontend URL
FRONTEND_URL=http://localhost:5173
